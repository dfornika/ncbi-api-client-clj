{:paths ["src/cljc" "src/clj" "src/cljs"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        hato/hato {:mvn/version "1.0.0"}
        cheshire/cheshire {:mvn/version "6.0.0"}}
 :aliases
 {:dev {:extra-paths ["src/dev" "scripts"]
        :extra-deps {clj-commons/clj-yaml {:mvn/version "1.0.29"}}}
  :test {:extra-paths ["src/test" "test-resources" "scripts"]
         :extra-deps {clj-commons/clj-yaml {:mvn/version "1.0.29"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                            :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "src/test"]}
  ;; the ClojureScript tests: clojure -M:cljs-test && node target/test/node-tests.js
  :cljs {:extra-paths ["src/test"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.14"}}}
  :cljs-test {:extra-paths ["src/test"]
              :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.14"}}
              :main-opts ["-m" "shadow.cljs.devtools.cli" "compile" "test"]}
  ;; regenerate src/cljc/ncbi_api_client/datasets/routes.cljc from the spec
  :gen-routes {:extra-paths ["scripts"]
               :extra-deps {clj-commons/clj-yaml {:mvn/version "1.0.29"}}
               :exec-fn gen-routes/write!}
  ;; (src/test is here so tests can be run from the REPL)
  :nrepl {:extra-paths ["src/test" "test-resources"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                       ch.qos.logback/logback-classic {:mvn/version "1.5.34"}}
          :jvm-opts ["-Djdk.attach.allowAttachSelf"]
          :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}}}
